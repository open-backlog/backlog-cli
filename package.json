{
  "name": "open-backlog",
  "version": "0.1.0",
  "description": "Open Backlog: a backlog as Markdown files in git. The ob command, and the core library it is built on.",
  "license": "MIT",
  "author": "Brandon Castagna",
  "homepage": "https://openbacklog.org",
  "keywords": [
    "backlog",
    "agile",
    "markdown",
    "git",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ob": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "smoke": "node script/smoke.mjs",
    "check": "npm run lint && npm run build && npm test && npm run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
